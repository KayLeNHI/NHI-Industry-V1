{
    "name": "local/seat-industry-planner",
    "description": "SeAT plugin that calculates manufacturable items from synced EVE Online blueprints and assets.",
    "type": "seat-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Local SeAT Admin"
        }
    ],
    "require": {
        "php": "^8.1",
        "eveseat/eveapi": "^5.0",
        "eveseat/services": "^5.0",
        "eveseat/web": "^5.0",
        "laravel/framework": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Local\\Seat\\IndustryPlanner\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Local\\Seat\\IndustryPlanner\\IndustryPlannerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
